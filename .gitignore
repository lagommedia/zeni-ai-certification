# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# database (SQLite is no longer used, but ignore stray local copies)
/dev.db
/dev.db-journal
/prisma/dev.db
/prisma/dev.db-journal

# transient snapshot used for the one-time SQLite -> Postgres migration
/prisma/sqlite-snapshot.json

# user-uploaded content-block attachments
/public/uploads

# personal local Claude Code settings — not meant to be shared
.claude/settings.local.json
